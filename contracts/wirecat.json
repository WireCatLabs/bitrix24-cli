{
  "wcat_manifest": 2,
  "name": "b24",
  "description": "read and change a Bitrix24 portal's CRM",
  "docs_url": "https://wirecat.dev/en/docs/b24",
  "package": "@wirecat/bitrix24-cli",
  "bin": "wcat-b24",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "summary": "every command by section; --json prints its contract, one path per call",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "summary": "one command contract, or all schemas, error reasons and explicit overrides",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "summary": "sign in with a Bitrix24 incoming webhook, or with a local application",
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "summary": "show how this profile signs in, and with --check as whom it acts",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "summary": "forget this profile's webhook address or application sign-in on this computer",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "summary": "list the profiles here and whether each is signed in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "account",
        "remove"
      ],
      "summary": "sign this profile out and forget it, keeping or deleting its data",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "account.remove",
      "entity": "account_removal"
    },
    {
      "path": [
        "sync"
      ],
      "summary": "bring the CRM's copy in the local store up to date: pipelines, companies,…",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "sync",
      "entity": "crm_sync"
    },
    {
      "path": [
        "store",
        "status"
      ],
      "summary": "how far each kind's sync is: rows saved, partial or complete, when it last…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.status",
      "entity": "crm_sync_progress"
    },
    {
      "path": [
        "store",
        "apply"
      ],
      "summary": "apply scope mine to the contacts already stored: remove those no deal or…",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.apply",
      "entity": "crm_contacts_removed"
    },
    {
      "path": [
        "store",
        "info"
      ],
      "summary": "the shared store's format, size and contents, and whether this tool can read it",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.info",
      "entity": "store_info"
    },
    {
      "path": [
        "store",
        "check"
      ],
      "summary": "check the local store for problems",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.check",
      "entity": "store_check"
    },
    {
      "path": [
        "store",
        "migrate"
      ],
      "summary": "migrate an older local store",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.migrate",
      "entity": "store_migration"
    },
    {
      "path": [
        "store",
        "rebuild"
      ],
      "summary": "rebuild the local store's search indexes",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.rebuild",
      "entity": "store_reindex"
    },
    {
      "path": [
        "store",
        "backup"
      ],
      "summary": "copy the store into a new file, while it is in use; never overwrites a file",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.backup",
      "entity": "store_backup"
    },
    {
      "path": [
        "store",
        "restore"
      ],
      "summary": "restore a backup and keep the current store, or roll back a breaking upgrade",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.restore",
      "entity": "store_restore"
    },
    {
      "path": [
        "store",
        "decrypt"
      ],
      "summary": "open a file written with --encrypt into a new file; asks for its password",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.decrypt",
      "entity": "store_decrypt"
    },
    {
      "path": [
        "store",
        "repair"
      ],
      "summary": "repair table shapes while keeping the old tables",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.repair",
      "entity": "store_repair"
    },
    {
      "path": [
        "store",
        "reset"
      ],
      "summary": "back up the local store and replace it with an empty one",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.reset",
      "entity": "store_reset"
    },
    {
      "path": [
        "store",
        "copies",
        "delete"
      ],
      "summary": "delete one copy `store repair` kept, named exactly; refuses any other table",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.copies.delete",
      "entity": "store_copy_removal"
    },
    {
      "path": [
        "store",
        "tables",
        "list"
      ],
      "summary": "every table of the local archive, with its kind and row count",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.tables.list",
      "entity": "store_table"
    },
    {
      "path": [
        "store",
        "recover"
      ],
      "summary": "what is damaged in the store and how to recover it",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.recover"
    },
    {
      "path": [
        "store",
        "recover",
        "run"
      ],
      "summary": "rebuild a damaged store from every row it can read",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "store.recover.run"
    },
    {
      "path": [
        "deals",
        "list"
      ],
      "summary": "deals copied from the CRM, newest first; run sync to bring them up to date",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "deals.list",
      "entity": "deal"
    },
    {
      "path": [
        "deals",
        "show"
      ],
      "summary": "one deal with its pipeline, stage, status, amount and the people on it, and…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "deals.show",
      "entity": "deal"
    },
    {
      "path": [
        "deals",
        "create"
      ],
      "summary": "make a deal in the CRM, then store the CRM's copy of it",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "deals.create",
      "entity": "crm_write"
    },
    {
      "path": [
        "deals",
        "update"
      ],
      "summary": "change a deal in the CRM; what is left out keeps its value; the CRM's copy…",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "deals.update",
      "entity": "crm_write"
    },
    {
      "path": [
        "deals",
        "move"
      ],
      "summary": "move a deal to another stage of its pipeline; a won or lost stage checks the…",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "deals.move",
      "entity": "crm_write"
    },
    {
      "path": [
        "deals",
        "close"
      ],
      "summary": "mark a deal won or lost, the CRM's own way",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "deals.close",
      "entity": "crm_write"
    },
    {
      "path": [
        "deals",
        "delete"
      ],
      "summary": "delete a deal in the CRM; asks first unless allowed",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "deals.delete",
      "entity": "crm_removal"
    },
    {
      "path": [
        "leads",
        "list"
      ],
      "summary": "leads copied from the CRM, newest first; run sync to bring them up to date",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "leads.list",
      "entity": "lead"
    },
    {
      "path": [
        "leads",
        "show"
      ],
      "summary": "one lead with its pipeline, stage, status, amount and the people on it, and…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "leads.show",
      "entity": "lead"
    },
    {
      "path": [
        "leads",
        "create"
      ],
      "summary": "make a lead in the CRM, then store the CRM's copy of it",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "leads.create",
      "entity": "crm_write"
    },
    {
      "path": [
        "leads",
        "update"
      ],
      "summary": "change a lead in the CRM; what is left out keeps its value; the CRM's copy…",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "leads.update",
      "entity": "crm_write"
    },
    {
      "path": [
        "leads",
        "move"
      ],
      "summary": "move a lead to another stage of its pipeline; a won or lost stage checks the…",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "leads.move",
      "entity": "crm_write"
    },
    {
      "path": [
        "leads",
        "close"
      ],
      "summary": "mark a lead won or lost, the CRM's own way",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "leads.close",
      "entity": "crm_write"
    },
    {
      "path": [
        "leads",
        "delete"
      ],
      "summary": "delete a lead in the CRM; asks first unless allowed",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "leads.delete",
      "entity": "crm_removal"
    },
    {
      "path": [
        "pipelines",
        "list"
      ],
      "summary": "pipelines copied from the CRM, with their stages in order and how many are…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "pipelines.list",
      "entity": "pipeline"
    },
    {
      "path": [
        "pipelines",
        "show"
      ],
      "summary": "one pipeline as a board and a funnel: how many stand in each stage and their…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "pipelines.show",
      "entity": "pipeline"
    },
    {
      "path": [
        "stages",
        "list"
      ],
      "summary": "every stage of the CRM's pipelines in order, with its outcome and how many…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "stages.list",
      "entity": "stage"
    },
    {
      "path": [
        "fields",
        "list"
      ],
      "summary": "the CRM's custom fields of one kind, in its order, with a list field's options",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "fields.list",
      "entity": "crm_field"
    },
    {
      "path": [
        "search",
        "all"
      ],
      "summary": "search stored deals and leads, messages, notes, calendar events and meetings",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "search.all",
      "entity": "hit"
    },
    {
      "path": [
        "people",
        "list"
      ],
      "summary": "list contacts on the portal, newest first",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "people.list",
      "entity": "crm_person"
    },
    {
      "path": [
        "people",
        "show"
      ],
      "summary": "show one of the contacts on the portal",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "people.show",
      "entity": "crm_person"
    },
    {
      "path": [
        "people",
        "create"
      ],
      "summary": "create one person on the portal",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "people.create",
      "entity": "crm_record_created"
    },
    {
      "path": [
        "people",
        "update"
      ],
      "summary": "change one person on the portal; options left out keep their values",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "people.update",
      "entity": "crm_record_updated"
    },
    {
      "path": [
        "organizations",
        "list"
      ],
      "summary": "list companies on the portal, newest first",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "organizations.list",
      "entity": "crm_organization"
    },
    {
      "path": [
        "organizations",
        "show"
      ],
      "summary": "show one of the companies on the portal",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "organizations.show",
      "entity": "crm_organization"
    },
    {
      "path": [
        "organizations",
        "create"
      ],
      "summary": "create one organization on the portal",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "organizations.create",
      "entity": "crm_record_created"
    },
    {
      "path": [
        "organizations",
        "update"
      ],
      "summary": "change one organization on the portal; options left out keep their values",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "organizations.update",
      "entity": "crm_record_updated"
    },
    {
      "path": [
        "products",
        "list"
      ],
      "summary": "list catalog products on the portal, newest first",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "products.list",
      "entity": "product"
    },
    {
      "path": [
        "products",
        "show"
      ],
      "summary": "show one of the catalog products on the portal",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "products.show",
      "entity": "product"
    },
    {
      "path": [
        "users",
        "list"
      ],
      "summary": "list employees on the portal, newest first",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "users.list",
      "entity": "user"
    },
    {
      "path": [
        "users",
        "show"
      ],
      "summary": "show one of the employees on the portal",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "users.show",
      "entity": "user"
    },
    {
      "path": [
        "api",
        "list"
      ],
      "summary": "list the Bitrix24 methods b24 calls, with their permissions",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "entity": "api_method"
    },
    {
      "path": [
        "api",
        "show"
      ],
      "summary": "show a method's REST version and permissions; calls nothing",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "api",
        "call"
      ],
      "summary": "call one Bitrix24 method by name with JSON parameters",
      "effects": {
        "remote": "write",
        "local": "write"
      }
    },
    {
      "path": [
        "schedule",
        "command"
      ],
      "summary": "run b24 <args…> on a timer — reads save what they read, so this is how a…",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "schedule.command"
    },
    {
      "path": [
        "schedule",
        "agent"
      ],
      "summary": "start an agent (claude, codex, gemini, cursor, opencode, openclaw, hermes,…",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "schedule.agent"
    },
    {
      "path": [
        "schedule",
        "list"
      ],
      "summary": "the schedules, when they run and how their last run went",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "schedule.list",
      "entity": "scheduled_job"
    },
    {
      "path": [
        "schedule",
        "agents",
        "list"
      ],
      "summary": "the agents a schedule may start, and which are on PATH here",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "schedule.agents.list",
      "entity": "schedule_harness"
    },
    {
      "path": [
        "schedule",
        "run"
      ],
      "summary": "run a schedule now, as its timer would, and wait for it; a paused one runs too",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "schedule.run"
    },
    {
      "path": [
        "schedule",
        "remove"
      ],
      "summary": "stop a schedule and remove its timer; its past output stays",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "schedule.remove"
    },
    {
      "path": [
        "schedule",
        "pause"
      ],
      "summary": "take a schedule off its timer and keep it; run runs it, resume puts it back",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "schedule.pause"
    },
    {
      "path": [
        "schedule",
        "resume"
      ],
      "summary": "put a paused schedule back on its timer",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "schedule.resume"
    },
    {
      "path": [
        "schedule",
        "exec"
      ],
      "summary": "what a timer runs, given the schedule's file; to run one by hand, use run",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "schedule.exec"
    },
    {
      "path": [
        "doctor"
      ],
      "summary": "the state this installation is in, without connecting unless --online",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "doctor",
        "reports",
        "show"
      ],
      "summary": "what a report holds and never holds, and where to send it; writes nothing",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "doctor",
        "reports",
        "create"
      ],
      "summary": "the report file written: its path, the run it is about, and where to send it",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "doctor.reports.create"
    },
    {
      "path": [
        "skill",
        "show"
      ],
      "summary": "print the tool's instructions for AI agents",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "install"
      ],
      "summary": "install the tool's instructions for AI agents",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "skill",
        "status"
      ],
      "summary": "whether the installed instructions for AI agents match this version",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "guide"
      ],
      "summary": "scenarios: the commands for a common task, in order, and why each",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "mcp",
        "serve"
      ],
      "summary": "serve this profile's commands to an AI agent",
      "effects": {
        "remote": "write",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "revoke"
      ],
      "summary": "forget every login given to a browser app",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "start"
      ],
      "summary": "start the HTTP MCP server in the background",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "stop"
      ],
      "summary": "stop the background HTTP MCP server",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "status"
      ],
      "summary": "whether the HTTP MCP server runs, its login code and the apps logged in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "config"
      ],
      "summary": "print the local MCP configuration of this profile, or of those --profiles names",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "add"
      ],
      "summary": "add this profile's local MCP server to Codex or Claude Code",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "check"
      ],
      "summary": "check this profile's local MCP handshake and tool list",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "upgrade"
      ],
      "summary": "upgrade b24 with the package manager that installed it; --check only looks",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "show"
      ],
      "summary": "the profile, the profiles that exist, and each setting with where it came from",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "config",
        "set"
      ],
      "summary": "save a setting to the configuration file",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "unset"
      ],
      "summary": "remove a setting from the configuration file",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "migrate"
      ],
      "summary": "write each setting the file lacks at its default, keeping yours",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "repair"
      ],
      "summary": "fix the settings file's JSON syntax, keeping every value",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "complete"
      ],
      "summary": "shell completion: `b24 complete zsh` prints the script to source",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "runs",
        "list"
      ],
      "summary": "recorded runs, newest first",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "entity": "run"
    },
    {
      "path": [
        "runs",
        "show"
      ],
      "summary": "one run: what it was, how it ended, and every event it logged",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "entity": "run"
    },
    {
      "path": [
        "runs",
        "path"
      ],
      "summary": "the directory holding one run",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "entity": "run_location"
    }
