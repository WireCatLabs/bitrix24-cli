#!/usr/bin/env bash
# Runs this checkout's build of `b24` against the owner's live portal, read-only by default.
# The webhook address comes from the keyring and reaches b24 only as B24_TOKEN; it is never printed.
# Config, state and the store are a throwaway folder: a branch build must not migrate the owner's real store.
#
#   bin/b24-live <account>            # builds this checkout, syncs into the throwaway store and reads; changes nothing
#   bin/b24-live <account> --write    # also creates one lead and one deal "WireCat test …",
#                           # changes, moves and deletes each, then syncs again and asks the portal that none is left;
#                           # when every step passed, appends
#                           # the version and commit to docs/dev/live-checks.txt, which bin/release checks
#   B24_KEYRING_ACCOUNT=<account> bin/b24-live [--write]
# <account> is the keyring entry `secret-tool store --label=… service bitrix24 account <account>` holds the webhook in.
set -euo pipefail

write=""
given=""
for arg in "$@"; do
  case "$arg" in
    --write) write=1 ;;
    *) given=$arg ;;
  esac
done
account=${given:-${B24_KEYRING_ACCOUNT:-}}
[ -n "$account" ] || {
  echo "name the keyring account that holds the portal's webhook (service bitrix24):" >&2
  echo "  bin/b24-live <account> [--write]   or   B24_KEYRING_ACCOUNT=<account> bin/b24-live [--write]" >&2
  exit 2
}

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# Built here, so the live record names the commit that actually ran.
(cd "$root" && pnpm -s build >/dev/null)

B24_TOKEN=$(secret-tool lookup service bitrix24 account "$account" 2>/dev/null) || true
[ -n "$B24_TOKEN" ] || { echo "no keyring entry: service bitrix24 account $account" >&2; exit 1; }
export B24_TOKEN

sandbox=$(mktemp -d)
# The output and the run records outlive the throwaway folder, so a failed step can be read afterwards; they hold field
# names and counts from the portal, never the webhook.
stamp=$(date +%Y%m%dT%H%M%S)
logs="${XDG_CACHE_HOME:-$HOME/.cache}/b24-live"
(umask 077 && mkdir -p "$logs")
exec > >(umask 077 && tee "$logs/$stamp.log") 2>&1
echo "log: $logs/$stamp.log"
trap 'cp -r "$sandbox/data/bitrix24-cli/runs" "$logs/$stamp-runs" 2>/dev/null; rm -rf "$sandbox"' EXIT
b24() {
  HOME="$sandbox" XDG_CONFIG_HOME="$sandbox/config" XDG_DATA_HOME="$sandbox/data" XDG_STATE_HOME="$sandbox/state" \
    XDG_CACHE_HOME="$sandbox/cache" MESSAGING_STORE="$sandbox/wirecat.db" DBUS_SESSION_BUS_ADDRESS=disabled: \
    node "$root/dist/bin/b24.js" live "$@"
}
failed=0
fail() { echo "!! $*"; failed=1; }
step() { printf '\n== b24 live %s\n' "$*"; b24 "$@" || fail "exit $?"; }
# One value out of a JSON answer on stdin, by a dotted path: `item.lead.ref`.
value() {
  node -e '
    let s = ""
    process.stdin.on("data", (d) => (s += d)).on("end", () => {
      let v
      try { v = process.argv[1].split(".").reduce((o, k) => o?.[k], JSON.parse(s)) } catch {}
      console.log(v ?? "")
    })' "$1"
}

step session status --check
# Nothing is chosen, as on a new install: a sync copies the signed-in user's deals, where the test lead and deal go.
me=$(b24 session status --check --json 2>/dev/null | value item.user.id)
[ -n "$me" ] || { echo "!! session status gave no user"; exit 1; }
echo "the first sync copies the portal into an empty store at the portal's pace, a request a second: minutes"
printf '\n== b24 live sync\n'
first=$(b24 sync --json=state,synced,issues,scope) || fail "exit $?"
printf '%s\n' "$first"
scope=$(printf '%s' "$first" | value item.scope.self):$(printf '%s' "$first" | value item.scope.also)
[ "$scope" = "$me:[]" ] || fail "with no one chosen the sync must copy the signed-in user $me alone, got $scope"
# The second sync asks only for what changed, through the updatedTime filter; every kind must answer it.
changed() {
  printf '\n== b24 live sync (changes)\n'
  b24 sync --json 2>/dev/null | node -e '
    let s = ""
    process.stdin.on("data", (d) => (s += d)).on("end", () => {
      let kinds = []
      try { kinds = JSON.parse(s).item?.synced ?? [] } catch {}
      const failed = kinds.filter((one) => one.error)
      for (const one of kinds) console.log(`${one.kind}: ${one.round} ${one.state}, saved ${one.saved}`)
      if (!kinds.length || failed.length) process.exit(1)
    })' || fail "a changes sync failed for some kind"
}
changed
step store status
step pipelines list --json=ref,name,kind
step stages list --json=pipeline_name,name,outcome,external_id,open
step deals list status:open --limit 3 --json=ref,title,pipeline_name,stage,status,amount,currency,close_date
step leads list --limit 3 --json=ref,title,stage,status,amount,currency
step people list --limit 3 --json=id,name
step organizations list --limit 3 --json=id,name

# The funnel board of one deal pipeline: only the shape is printed, never a stage's name or sum.
board=$(b24 pipelines list --json 2>/dev/null | node -e '
  let s = ""
  process.stdin.on("data", (d) => (s += d)).on("end", () => {
    let items = []
    try { items = JSON.parse(s).items ?? [] } catch {}
    console.log(items.find((one) => one.kind === "deal")?.ref ?? "")
  })')
printf '\n== b24 live pipelines show\n'
if [ -z "$board" ]; then fail "pipelines list has no deal pipeline"; else
  b24 pipelines show "$board" --json 2>/dev/null | node -e '
    let s = ""
    process.stdin.on("data", (d) => (s += d)).on("end", () => {
      let p
      try { p = JSON.parse(s).item } catch {}
      const stages = p?.stages ?? []
      const counted = stages.every((one) => "reached" in one && "items" in one)
      if (p?.kind !== "deal" || !stages.length || !counted || typeof p.totals?.win_rate === "undefined") process.exit(1)
      console.log(`ok: ${stages.length} stages, each with how many reached it, and the win rate`)
    })' || fail "pipelines show gave no funnel board"
fi

# A CSV page: a header, then one record per row. Counted, never printed.
csv() {
  printf '\n== b24 live %s list --format csv --limit 3\n' "$1"
  b24 "$1" list --format csv --limit 3 2>/dev/null | node -e '
    let s = ""
    process.stdin.on("data", (d) => (s += d)).on("end", () => {
      const records = [[]]
      let cell = "", quoted = false
      for (let i = 0; i < s.length; i++) {
        const c = s[i]
        if (quoted) {
          if (c === "\"" && s[i + 1] === "\"") { cell += c; i++ } else if (c === "\"") quoted = false; else cell += c
        } else if (c === "\"") quoted = true
        else if (c === ",") { records.at(-1).push(cell); cell = "" }
        else if (c === "\n") { records.at(-1).push(cell.replace(/\r$/, "")); cell = ""; records.push([]) }
        else cell += c
      }
      if (cell || records.at(-1).length) records.at(-1).push(cell); else records.pop()
      const [header = [], ...rows] = records
      const even = rows.every((row) => row.length === header.length)
      const keyed = ["id", "ref"].some((name) => header.includes(name))
      // No rows is a table too: a sync copies only the deals of the webhook user, who may hold none.
      if (quoted || !keyed || rows.length > 3 || !even) process.exit(1)
      console.log(`ok: a header of ${header.length} columns, then ${rows.length} rows of as many cells`)
    })' || fail "$1 list --format csv is not a CSV table with a header"
}
csv deals
csv people
step products list --limit 3
step users list --limit 3 --json=id,name
step fields list deals --all
step fields list leads --all

# Picks a custom field from `fields list` at run time, so no portal's own codes are written here:
# `list` prints `<code>:<option id>` of a list field a list can filter by, `string` the code of a one-value text field,
# `labelled` such a field's `<code>|<label>` when no other field has that label.
pick() {
  b24 fields list "$1" --all --json 2>/dev/null | node -e '
    let s = ""
    process.stdin.on("data", (d) => (s += d)).on("end", () => {
      let items = []
      try { items = JSON.parse(s).items ?? [] } catch {}
      const kind = process.argv[1]
      const unique = (one) => one.label && items.filter((other) => other.label === one.label).length === 1
      const f = kind === "list"
        ? items.find((one) => one.filterable && one.options?.length)
        : items.find((one) => one.type === "string" && !one.multiple && (kind !== "labelled" || unique(one)))
      if (f) console.log(kind === "list" ? `${f.code}:${f.options[0].id}` : kind === "labelled" ? `${f.code}|${f.label}` : f.code)
    })' "$2" || true
}

term=$(pick organizations list)
if [ -n "$term" ]; then
  step organizations list "$term" --limit 3 --json=id,name
else
  echo "no list field on companies that a list can filter by — skipped the filtered organizations list"
fi

if [ -z "$write" ]; then
  [ "$failed" = 0 ] || exit 1
  echo "read-only run passed; the release record needs bin/b24-live --write"
  exit 0
fi

title="WireCat test $(date +%Y-%m-%dT%H:%M)"

# A lead: created with one custom string field, named by its label, when the portal has one, renamed, moved, closed
# lost, deleted. Never closed won: a won lead is a converted one.
custom=$(pick leads labelled)
field=()
if [ -n "$custom" ]; then field=(--field "${custom#*|}=$title"); else echo "no labelled one-value string field on leads — no --field"; fi
# Bitrix24 made a second record for a create repeated with one Idempotency-Key, so --operation-id must be refused
# before anything is sent.
if b24 leads create --title "$title" --operation-id "wirecat-live-$(date +%s)" --json >/dev/null 2>&1; then
  fail "leads create took --operation-id"
else echo "ok: leads create refuses --operation-id"; fi
lead=$(b24 leads create --title "$title" "${field[@]}" --json | value item.lead.ref)
[ -n "$lead" ] || { echo "!! leads create gave no ref"; exit 1; }
echo "created $lead: $title"
step leads show "$lead" --json=ref,title,stage,status,assignee
if [ -n "$custom" ]; then
  kept=$(b24 leads show "$lead" --json | value "item.provider_metadata.${custom%%|*}.value") || true
  if [ "$kept" = "$title" ]; then echo "ok: --field by label set ${custom%%|*}"; else
    fail "--field by label left ${custom%%|*} as '$kept'"
  fi
fi
step leads update "$lead" --title "$title (renamed)" --json=operation_id,lead.title
step leads move "$lead" IN_PROCESS --json=lead.stage,lead.status
step leads close "$lead" lost --json=lead.stage,lead.status
step leads delete "$lead" --yes --json=ref,removed
echo "deleted $lead"

# A deal in the first deal pipeline: created, given a close date, moved to its second open stage, deleted.
stages=$(b24 stages list kind:deal --json)
pipeline=$(printf '%s' "$stages" | value items.0.pipeline)
next=$(printf '%s' "$stages" | node -e '
  let s = ""
  process.stdin.on("data", (d) => (s += d)).on("end", () => {
    const items = JSON.parse(s).items ?? []
    const open = items.filter((one) => one.pipeline === items[0]?.pipeline && one.outcome === "open")
    console.log(open[1]?.external_id ?? "")
  })')
deal=$(b24 deals create --title "$title" --pipeline "$pipeline" --json | value item.deal.ref)
[ -n "$deal" ] || { echo "!! deals create gave no ref"; exit 1; }
echo "created $deal: $title"
step deals update "$deal" --close-date "$(date -d '+30 days' +%Y-%m-%d)" --json=deal.close_date
if [ -n "$next" ]; then step deals move "$deal" "$next" --json=deal.stage,deal.status; else echo "one open stage only — no move"; fi
step deals delete "$deal" --yes --json=ref,removed
echo "deleted $deal"

# A sync from the cursor (the updatedTime filter), then a rescan with the id pass: neither brings the deleted ones back.
changed
# Asked of the portal itself: a rescan that finds the deletions does not finish in one run on a large portal.
for type in lead deal; do
  for named in "$title" "$title (renamed)"; do
    left=$(b24 api call "crm.$type.list" --body "{\"select\":[\"id\"],\"filter\":[[\"title\",\"=\",\"$named\"]]}" \
      --json | value item.result.items.length)
    if [ "$left" = 0 ]; then echo "ok: the portal has no $type titled \"$named\""; else
      fail "the portal answered '$left' ${type}s titled \"$named\""
    fi
  done
done

[ "$failed" = 0 ] || { echo "a step failed: no live record" >&2; exit 1; }
(cd "$root" && pnpm exec cli-dev live record --script bin/b24-live)
echo "every step passed: commit docs/dev/live-checks.txt in the release pull request"
